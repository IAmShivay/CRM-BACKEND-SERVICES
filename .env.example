# Local dev only. Deployed environments pull these from Infisical (see VPS.md / k8s/SETUP.md).
# With the Infisical CLI: infisical run --env=dev -- docker compose up -d

NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/crm-sass
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# Auth Service
AUTH_SERVICE_PORT=8001

# Sales Service
SALES_SERVICE_PORT=8002

# HR Service
HR_SERVICE_PORT=8003

# WhatsApp Service
WHATSAPP_SERVICE_PORT=8004
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Social Media Service
SOCIAL_SERVICE_PORT=8005
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Billing Service
BILLING_SERVICE_PORT=8006
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_SUBSCRIPTIONS_ENABLED=true
PUBLIC_API_URL=http://localhost:8000
BILLING_SERVICE_URL=http://billing-service:8006

# Marketing Service
MARKETING_SERVICE_PORT=8007
RESEND_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CRON_SECRET=

# Collaboration Service
COLLABORATION_SERVICE_PORT=8008
JAAS_APP_ID=

# Analytics Service
ANALYTICS_SERVICE_PORT=8009

# CMS Service
CMS_SERVICE_PORT=8010

# N8N
N8N_PASSWORD=admin123
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# Storage
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=crm-uploads

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Service-to-service
INTERNAL_API_KEY=
WHATSAPP_SERVICE_URL=http://whatsapp-service:8004
MARKETING_SERVICE_URL=http://marketing-service:8007
APP_URL=http://localhost:3000
PLATFORM_OPENROUTER_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Social lead forms (social-service)
META_APP_ID=
FACEBOOK_APP_ID=
META_WEBHOOK_VERIFY_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
SOCIAL_OAUTH_REDIRECT=http://localhost:3000/webhooks/callback

# Misc
SALES_SERVICE_URL=http://sales-service:8002
SMS_PROVIDER=msg91
LOG_LEVEL=info

# Google / Microsoft OAuth (login + Gmail/Outlook email accounts)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Web push (generate once: node -e "console.log(require('web-push').generateVAPIDKeys())")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# File storage (avatars, blog images): minio | gcs
STORAGE_PROVIDER=minio
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_BUCKET_NAME=crm-uploads
MINIO_PUBLIC_URL=
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
